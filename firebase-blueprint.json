{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "staff", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Mock test details and question bank",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "duration": { "type": "number", "description": "Duration in minutes" },
        "sections": { "type": "object" },
        "answerKey": { "type": "object" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "startTime", "endTime", "duration", "sections", "createdBy"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Student exam submission and responses",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "examId": { "type": "string" },
        "answers": { "type": "object" },
        "score": { "type": "number" },
        "status": { "type": "string", "enum": ["in-progress", "completed"] },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "examId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "Mock tests"
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Student test results (ID is userId_examId)"
    }
  }
}
